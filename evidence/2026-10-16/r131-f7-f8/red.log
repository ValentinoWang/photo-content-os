                      'shots': [{'shot': {'startSeconds': a, 'endSeconds': b}} for a,b in [(0,.8),(.8,1.6),(1.6,3)]]}
        cues = subtitles.build_subtitle_cues(descriptor, fps=30, total_frames=91)
