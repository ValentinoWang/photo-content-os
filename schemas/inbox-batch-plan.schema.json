{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photo-content-os.local/schemas/inbox_batch_plan.schema.json",
  "title": "Photo Content OS inbox event batch plan",
  "description": "Read-only, deterministic proposal. A separate confirmed workflow must verify the manifest digest before migration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_manifest", "thresholds", "confirmation_status", "migration_status", "batches", "pending_items"],
  "properties": {
    "schema_version": {"const": "inbox_batch_plan_v1"},
    "input_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "manifest_version", "item_count"],
      "properties": {
        "manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "manifest_version": {"type": "integer", "minimum": 1},
        "item_count": {"type": "integer", "minimum": 0}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time_gap_seconds", "distance_meters"],
      "properties": {
        "time_gap_seconds": {"type": "integer", "minimum": 1},
        "distance_meters": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "confirmation_status": {"const": "pending"},
    "migration_status": {"const": "not_requested"},
    "batches": {"type": "array", "items": {"$ref": "#/$defs/batch"}},
    "pending_items": {"type": "array", "items": {"$ref": "#/$defs/pending_item"}}
  },
  "$defs": {
    "source_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "count"],
      "properties": {"source_type": {"type": "string", "minLength": 1}, "count": {"type": "integer", "minimum": 1}}
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_id", "confirmation_status", "media_ids", "live_group_unit_ids", "captured_at_start", "captured_at_end", "source_composition"],
      "properties": {
        "batch_id": {"type": "string", "pattern": "^event-[0-9]{3,}$"},
        "confirmation_status": {"const": "pending"},
        "media_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "live_group_unit_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^live:"}},
        "captured_at_start": {"type": "string", "format": "date-time"},
        "captured_at_end": {"type": "string", "format": "date-time"},
        "source_composition": {"type": "array", "items": {"$ref": "#/$defs/source_count"}}
      }
    },
    "pending_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit_id", "is_live_group", "media_ids", "reasons"],
      "properties": {
        "unit_id": {"type": "string", "minLength": 1},
        "is_live_group": {"type": "boolean"},
        "media_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["missing_captured_at", "missing_gps"]}}
      }
    }
  }
}
