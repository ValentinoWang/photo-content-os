{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editing-presets.schema.json",
  "title": "R226 B2a editing presets contract (not a registered endpoint)",
  "$ref": "#/$defs/library_response",
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beats_per_cut": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quiet": {
              "type": "integer",
              "minimum": 1
            },
            "build": {
              "type": "integer",
              "minimum": 1
            },
            "peak": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "quiet",
            "build",
            "peak"
          ]
        },
        "techniques": {
          "type": "array",
          "items": {
            "enum": [
              "jcut",
              "bed",
              "duck",
              "pause",
              "action"
            ]
          },
          "uniqueItems": true
        },
        "order": {
          "enum": [
            "story",
            "sports",
            "selfie"
          ]
        }
      },
      "required": [
        "beats_per_cut",
        "techniques",
        "order"
      ]
    },
    "technique_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jcut": {
          "type": "boolean"
        },
        "bed": {
          "type": "boolean"
        },
        "duck": {
          "type": "boolean"
        },
        "pause": {
          "type": "boolean"
        },
        "action": {
          "type": "boolean"
        }
      },
      "required": []
    },
    "preset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "enum": [
            "builtin",
            "mine"
          ]
        },
        "base_preset_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "旅行",
            "运动",
            "日常",
            "我的"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "recipe": {
          "$ref": "#/$defs/recipe"
        },
        "overrides": {
          "$ref": "#/$defs/technique_overrides"
        },
        "created_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "origin",
        "base_preset_id",
        "name",
        "category",
        "description",
        "recipe",
        "overrides",
        "created_at",
        "revision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "mine"
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "const": "我的预设"
              },
              "category": {
                "const": "我的"
              },
              "base_preset_id": {
                "type": "string",
                "minLength": 1
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "else": {
            "properties": {
              "category": {
                "enum": [
                  "旅行",
                  "运动",
                  "日常"
                ]
              },
              "base_preset_id": {
                "type": "null"
              },
              "created_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "all",
            "travel",
            "sports",
            "daily",
            "mine"
          ]
        },
        "label": {
          "enum": [
            "全部",
            "旅行",
            "运动",
            "日常",
            "我的"
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "label",
        "count"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "enum": [
                  "all",
                  "travel",
                  "sports",
                  "daily"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "library_response": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": {
          "const": true
        },
        "schema_version": {
          "const": "editing_presets_api_v1"
        },
        "revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mine_status": {
          "enum": [
            "readable",
            "absent",
            "unreadable"
          ]
        },
        "can_save": {
          "type": "boolean"
        },
        "presets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/preset"
          },
          "minItems": 6
        },
        "categories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/category"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "const": "preset_store_unreadable"
                },
                "design_state": {
                  "const": "cut-presets-unreadable"
                }
              },
              "required": [
                "code",
                "design_state"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "ok",
        "schema_version",
        "revision",
        "mine_status",
        "can_save",
        "presets",
        "categories",
        "total",
        "warning"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "mine_status": {
                "const": "unreadable"
              }
            }
          },
          "then": {
            "properties": {
              "revision": {
                "type": "null"
              },
              "can_save": {
                "const": false
              },
              "presets": {
                "items": {
                  "properties": {
                    "origin": {
                      "const": "builtin"
                    }
                  }
                }
              },
              "warning": {
                "type": "object"
              },
              "categories": {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "mine"
                    },
                    "count": {
                      "type": "null"
                    }
                  },
                  "required": [
                    "id",
                    "count"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "can_save": {
                "const": true
              },
              "warning": {
                "type": "null"
              },
              "categories": {
                "items": {
                  "properties": {
                    "count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      ],
