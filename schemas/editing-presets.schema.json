    "create_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedRevision": {
          "type": "integer",
          "minimum": 1
        },
        "piece_id": {
          "type": "string",
          "minLength": 1
        },
        "roughcut_revision": {
          "type": "integer",
          "minimum": 1
        },
        "base_preset_id": {
          "type": "string",
          "minLength": 1
        },
        "overrides": {
          "$ref": "#/$defs/technique_overrides"
        }
      },
