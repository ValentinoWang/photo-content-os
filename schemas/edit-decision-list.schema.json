{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photo-content-os.local/schemas/edit_decision_list.schema.json",
  "title": "Photo Content OS Edit Decision List",
  "description": "Canonical edit decision document shared by the AI, preview, handoff and editor backends. v2 adds the role/layer vocabulary plus transition, speed, crop, motion, audio, subtitle and music coverage. Every v2 field is optional, so a v1 document validates unchanged.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "doc_type",
    "source_script_used",
    "generation_model",
    "generation_reasoning",
    "clips",
    "missing_materials"
  ],
  "$defs": {
    "crop": {
      "type": "object",
      "description": "Normalised source rectangle, expressed as fractions of the source frame.",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "transform": {
      "type": "object",
      "description": "Geometry and motion applied to the clip. `animation` carries Ken Burns style moves such as ken-burns-slow-zoom, pan-left or static.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "animation": {
          "type": "string",
          "minLength": 1
        },
        "crop": {
          "$ref": "#/$defs/crop"
        }
      }
    },
    "music_track": {
      "type": "object",
      "description": "One background music bed. Placement is explicit; the contract never invents a source.",
      "additionalProperties": true,
      "required": [
        "source",
        "timeline_start_sec"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "timeline_start_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "timeline_end_sec": {
          "type": "number",
          "minimum": 0
        },
        "source_start_sec": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "fade_in_sec": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_sec": {
          "type": "number",
          "minimum": 0
        },
        "duck_to": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Music level held under speech, used by the mixer when ducking."
        },
        "loop": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "enum": [
        "edit_decision_list_v1",
        "edit_decision_list_v2"
      ],
      "description": "v2 is emitted only when the document actually uses v2 vocabulary; otherwise the contract keeps writing v1."
    },
    "doc_type": {
      "const": "edit_decision_list"
    },
    "source_script_used": {
      "const": true
    },
    "generation_model": {
      "type": "string",
      "minLength": 1
    },
    "generation_reasoning": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string"
    },
    "project_revision": {
      "type": [
        "integer",
        "string"
      ]
    },
    "missing_materials": {
      "type": "array"
    },
    "audio": {
      "type": "object",
      "description": "Whole-cut audio settings, for example master gain, speech normalisation target or ducking policy.",
      "additionalProperties": true
    },
    "subtitles": {
      "type": "object",
      "description": "Whole-cut subtitle render settings. Per-clip subtitle text stays in each clip's caption field.",
      "additionalProperties": true
    },
    "music": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/music_track"
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "slot",
          "time_range",
          "source_start_sec",
          "purpose",
          "visual_need",
          "caption",
          "candidate_files",
          "edit_note"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1
          },
          "time_range": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{3})-\\d+(?:\\.\\d{3})$"
          },
          "source_start_sec": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "candidate_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "visual_need": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1
          },
          "edit_note": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "role": {
            "enum": [
              "a_roll",
              "b_roll",
              "overlay",
              "title"
            ],
            "description": "The narrative job this clip performs. Orthogonal to layer: a full-screen B-roll cutaway is role=b_roll on layer=primary, while the same footage as a picture-in-picture insert is role=b_roll on layer=overlay."
          },
          "layer": {
            "enum": [
              "primary",
              "overlay",
              "background"
            ],
            "default": "primary",
            "description": "Where the clip sits in the composition stack. Absent means primary. Only the primary layer must stay sequential and non-overlapping."
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1.0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "transform": {
            "$ref": "#/$defs/transform"
          },
          "transition_in": {
            "type": "string",
            "minLength": 1,
            "description": "Transition entering this clip, for example fade, dissolve, cut or wipe."
          },
          "transition_out": {
            "type": "string",
            "minLength": 1
          },
          "transition_duration": {
            "type": "number",
            "minimum": 0,
            "description": "Transition length in seconds. Only meaningful alongside transition_in or transition_out."
          }
        },
        "anyOf": [
          {
            "required": [
              "source_file"
            ]
          },
          {
            "properties": {
              "candidate_files": {
                "minItems": 1
              }
            }
          }
        ]
      }
    }
  }
}
