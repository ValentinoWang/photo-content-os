{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photo-content-os.local/schemas/edit-decision-list.schema.json",
  "title": "Photo Content OS Edit Decision List",
  "description": "Canonical edit decision document shared by the AI, preview, handoff and editor backends. v2 adds the role/layer vocabulary plus transition, speed, crop, motion, audio, subtitle and music coverage. Every v2 field is optional, so a v1 document validates unchanged. Audio timing uses milliseconds, speed=1, adjacent primary J/L handles; media bounds and cross-field constraints are checked by edl_contract and audio_plan. Media-first deterministic plans declare provenance with source_script_used=false; only those plans may omit generation_model and generation_reasoning.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "doc_type",
    "source_script_used",
    "clips",
    "missing_materials"
  ],
  "$defs": {
    "crop": {
      "type": "object",
      "description": "Normalised source rectangle, expressed as fractions of the source frame.",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "transform": {
      "type": "object",
      "description": "Geometry and motion applied to the clip. `animation` carries Ken Burns style moves such as ken-burns-slow-zoom, pan-left or static.",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "position": {
          "type": "string",
          "minLength": 1
        },
        "animation": {
          "type": "string",
          "minLength": 1
        },
        "crop": {
          "$ref": "#/$defs/crop"
        }
      }
    },
    "music_track": {
      "type": "object",
      "description": "One background music bed. Placement is explicit; the contract never invents a source.",
      "additionalProperties": true,
      "required": [
        "source",
        "timeline_start_sec"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "timeline_start_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "timeline_end_sec": {
          "type": "number",
          "minimum": 0
        },
        "source_start_sec": {
          "type": "number",
          "minimum": 0
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "fade_in_sec": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_sec": {
          "type": "number",
          "minimum": 0
        },
        "duck_to": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Legacy absolute level under trusted speech spans. Execution blocks without explicit speech intervals. Ignored when duck_regions is present."
        },
        "loop": {
          "type": "boolean"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "duck_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/duck_region"
          },
          "description": "Takes precedence over duck_to, including an explicitly empty array."
        }
      }
    },
    "duck_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_sec",
        "end_sec",
        "gain",
        "ramp_sec"
      ],
      "properties": {
        "start_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "end_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "ramp_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "Film-time plateau. Ramps lie outside it and must stay inside the song; overlapping ramp spans must be merged. Gain multiplies base volume."
    },
    "audio_bed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_start_sec",
        "timeline_start_sec",
        "timeline_end_sec"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_start_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "timeline_start_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "timeline_end_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "fade_in_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "fade_out_sec": {
          "type": "number",
          "minimum": 0,
          "multipleOf": 0.001
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "media_first_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "planner",
        "planner_version",
        "preset_id",
        "input_digest"
      ],
      "properties": {
        "kind": {
          "const": "media_first_planner"
        },
        "planner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "planner_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "preset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "preset_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "input_digest": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-fA-F]{64}$"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "enum": [
        "edit_decision_list_v1",
        "edit_decision_list_v2"
      ],
      "description": "v2 is emitted only when the document actually uses v2 vocabulary; otherwise the contract keeps writing v1."
    },
    "doc_type": {
      "const": "edit_decision_list"
    },
    "source_script_used": {
      "type": "boolean"
    },
    "generation_model": {
      "type": "string",
      "minLength": 1
    },
    "generation_reasoning": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string"
    },
    "project_revision": {
      "type": [
        "integer",
        "string"
      ]
    },
    "missing_materials": {
      "type": "array"
    },
    "audio": {
      "type": "object",
      "description": "Whole-cut settings only. Audio tracks belong in audio_beds and music.",
      "additionalProperties": true,
      "not": {
        "required": [
          "tracks"
        ]
      }
    },
    "subtitles": {
      "type": "object",
      "description": "Whole-cut subtitle render settings. Per-clip subtitle text stays in each clip's caption field.",
      "additionalProperties": true
    },
    "music": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/music_track"
      }
    },
    "clips": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "slot",
          "time_range",
          "source_start_sec",
          "purpose",
          "visual_need",
          "caption",
          "candidate_files",
          "edit_note"
        ],
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 1
          },
          "time_range": {
            "type": "string",
            "pattern": "^\\d+(?:\\.\\d{3})-\\d+(?:\\.\\d{3})$"
          },
          "source_start_sec": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          },
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "candidate_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "visual_need": {
            "type": "string",
            "minLength": 1
          },
          "caption": {
            "type": "string",
            "description": "Canonical caption text. Media-first input may omit caption; normalization emits an empty string. Other origins require nonempty captions."
          },
          "edit_note": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "role": {
            "enum": [
              "a_roll",
              "b_roll",
              "overlay",
              "title"
            ],
            "description": "The narrative job this clip performs. Orthogonal to layer: a full-screen B-roll cutaway is role=b_roll on layer=primary, while the same footage as a picture-in-picture insert is role=b_roll on layer=overlay."
          },
          "layer": {
            "enum": [
              "primary",
              "overlay",
              "background"
            ],
            "default": "primary",
            "description": "Where the clip sits in the composition stack. Absent means primary. Only the primary layer must stay sequential and non-overlapping."
          },
          "speed": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1.0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "transform": {
            "$ref": "#/$defs/transform"
          },
          "transition_in": {
            "type": "string",
            "minLength": 1,
            "description": "Transition entering this clip, for example fade, dissolve, cut or wipe."
          },
          "transition_out": {
            "type": "string",
            "minLength": 1
          },
          "transition_duration": {
            "type": "number",
            "minimum": 0,
            "description": "Transition length in seconds. Only meaningful alongside transition_in or transition_out."
          },
          "audio_lead_sec": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          },
          "audio_tail_sec": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          },
          "audio_fade_in_sec": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          },
          "audio_fade_out_sec": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.001
          },
          "audio_mute": {
            "type": "boolean",
            "description": "Mutes this clip only; overrides its volume and fades, not beds or music."
          }
        },
        "anyOf": [
          {
            "required": [
              "source_file"
            ]
          },
          {
            "properties": {
              "candidate_files": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    "audio_beds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audio_bed"
      }
    },
    "provenance": {
      "$ref": "#/$defs/media_first_provenance"
    }
  },
  "if": {
    "required": [
      "provenance"
    ]
  },
  "then": {
    "properties": {
      "source_script_used": {
        "const": false
      },
      "generation_model": {
        "pattern": "\\S"
      },
      "generation_reasoning": {
        "pattern": "\\S"
      }
    }
  },
  "else": {
    "required": [
      "schema_version",
      "doc_type",
      "source_script_used",
      "generation_model",
      "generation_reasoning",
      "clips",
      "missing_materials"
    ],
    "properties": {
      "source_script_used": {
        "const": true
      },
      "clips": {
        "items": {
          "properties": {
            "caption": {
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
