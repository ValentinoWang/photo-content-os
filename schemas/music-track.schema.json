{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "music-track.schema.json",
  "title": "Local music track",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string",
      "minLength": 1
    },
    "album": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "enum": [
        "qishui",
        "douyin",
        "netease",
        "netease_client",
        "local"
      ]
    },
    "platform_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "original_url": {
      "type": "string",
      "minLength": 1
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audio_file": {
      "type": "string",
      "pattern": "^audio\\.(mp3|m4a|mp4|flac|wav|ogg|aac)$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "platform_id",
          "kind",
          "original_url",
          "imported_at"
        ],
        "properties": {
          "platform": {
            "enum": [
              "qishui",
              "douyin",
              "netease",
              "netease_client",
              "local"
            ]
          },
          "platform_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "kind": {
            "enum": [
              "song",
              "music",
              "video",
              "note",
              "file"
            ]
          },
          "original_url": {
            "type": "string",
            "minLength": 1
          },
          "imported_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sample_rate_hz": {
      "type": "integer",
      "minimum": 1
    },
    "loudness_lufs": {
      "type": [
        "number",
        "null"
      ]
    },
    "loudness_status": {
      "enum": [
        "measured",
        "silence"
      ]
    }
  },
  "required": [
    "schema_version",
    "title",
    "artist",
    "album",
    "platform",
    "platform_id",
    "original_url",
    "imported_at",
    "file_sha256",
    "audio_file",
    "sources",
    "duration_seconds",
    "sample_rate_hz",
    "loudness_lufs",
    "loudness_status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "loudness_status": {
            "const": "measured"
          }
        }
      },
      "then": {
        "properties": {
          "loudness_lufs": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "loudness_lufs": {
            "type": "null"
          }
        }
      }
    }
  ]
}
