{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "music-track.schema.json",
  "title": "Local music track",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "artist": {
      "type": "string",
      "minLength": 1
    },
    "album": {
      "type": [
        "string",
        "null"
      ]
    },
    "platform": {
      "enum": [
        "qishui",
        "douyin",
        "netease",
        "netease_client",
        "local",
        "ai_generated"
      ]
    },
    "platform_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "original_url": {
      "type": "string",
      "minLength": 1
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audio_file": {
      "type": "string",
      "pattern": "^audio\\.(mp3|m4a|mp4|flac|wav|ogg|aac)$"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "platform_id",
          "kind",
          "original_url",
          "imported_at"
        ],
        "properties": {
          "platform": {
            "enum": [
              "qishui",
              "douyin",
              "netease",
              "netease_client",
              "local",
              "ai_generated"
            ]
          },
          "platform_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "kind": {
            "enum": [
              "song",
              "music",
              "video",
              "note",
              "file",
              "generated"
            ]
          },
          "original_url": {
            "type": "string",
            "minLength": 1
          },
          "imported_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sample_rate_hz": {
      "type": "integer",
      "minimum": 1
    },
    "loudness_lufs": {
      "type": [
        "number",
        "null"
      ]
    },
    "loudness_status": {
      "enum": [
        "measured",
        "silence"
      ]
    },
    "ai_generated": {
      "type": "boolean"
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "prompt",
        "params",
        "request_id",
        "generated_at"
      ],
      "properties": {
        "provider": {
          "enum": [
            "wavespeed",
            "bailian"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seconds",
            "bpm",
            "instrumental"
          ],
          "properties": {
            "seconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "bpm": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "instrumental": {
              "type": "boolean"
            }
          }
        },
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "billed_seconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "required": [
    "schema_version",
    "title",
    "artist",
    "album",
    "platform",
    "platform_id",
    "original_url",
    "imported_at",
    "file_sha256",
    "audio_file",
    "sources",
    "duration_seconds",
    "sample_rate_hz",
    "loudness_lufs",
    "loudness_status"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "loudness_status": {
            "const": "measured"
          }
        }
      },
      "then": {
        "properties": {
          "loudness_lufs": {
            "type": "number"
          }
        }
      },
      "else": {
        "properties": {
          "loudness_lufs": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "platform": {
            "const": "ai_generated"
          }
        },
        "required": [
          "platform"
        ]
      },
      "then": {
        "required": [
          "ai_generated",
          "generation"
        ],
        "properties": {
          "ai_generated": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ai_generated": {
            "const": true
          }
        },
        "required": [
          "ai_generated"
        ]
      },
      "then": {
        "required": [
          "generation"
        ]
      }
    }
  ]
}
