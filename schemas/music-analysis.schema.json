{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "duration_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "beat": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "done"
            },
            "package_versions": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "registry_version": {
              "type": "integer",
              "minimum": 1
            },
            "beats": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              },
              "minItems": 2
            },
            "downbeats": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0
              }
            },
            "beat_energy": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "minItems": 2
            },
            "sections": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "number",
                    "minimum": 0
                  },
                  "end": {
                    "type": "number",
                    "minimum": 0
                  },
                  "kind": {
                    "enum": [
                      "quiet",
                      "build",
                      "peak"
                    ]
                  }
                },
                "required": [
                  "start",
                  "end",
                  "kind"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "status",
            "package_versions",
            "models",
            "registry_version",
            "beats",
            "downbeats",
            "beat_energy",
            "sections"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "failed"
            },
            "failure": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "retryable"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "failure"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tags": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "done"
            },
            "package_versions": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "models": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "registry_version": {
              "type": "integer",
              "minimum": 1
            },
            "scores": {
              "type": "object",
              "properties": {
                "genre": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 400,
                  "maxItems": 400
                },
                "moodtheme": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 56,
                  "maxItems": 56
                },
                "instrument": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 40,
                  "maxItems": 40
                },
                "voice": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    ],
                    "items": false,
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "genre",
                "moodtheme",
                "instrument",
                "voice"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "package_versions",
            "models",
            "registry_version",
            "scores"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "const": "failed"
            },
            "failure": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "retryable"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "failure"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "file_sha256",
    "duration_seconds",
    "registry_version",
    "beat",
    "tags"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
