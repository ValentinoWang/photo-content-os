{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "music_analysis.registry.v1"
    },
    "registry_version": {
      "type": "integer",
      "minimum": 1
    },
    "updated_on": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "governance": {
      "type": "object",
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "drafter": {
          "type": "string",
          "minLength": 1
        },
        "implementer": {
          "type": "string",
          "minLength": 1
        },
        "change_gate": {
          "type": "string",
          "minLength": 1
        },
        "design_doc": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "owner",
        "drafter",
        "implementer",
        "change_gate",
        "design_doc",
        "rules"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "raw_scores": {
          "type": "string",
          "minLength": 1
        },
        "display_tags": {
          "type": "string",
          "minLength": 1
        },
        "human_override": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "raw_scores",
        "display_tags",
        "human_override"
      ],
      "additionalProperties": false
    },
    "analyzers": {
      "type": "object",
      "properties": {
        "beat": {
          "type": "object"
        },
        "energy_and_sections": {
          "type": "object"
        },
        "tags": {
          "type": "object",
          "properties": {
            "package": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "models": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "license": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "id",
                  "role",
                  "url",
                  "sha256",
                  "license",
                  "bytes"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "package",
            "version",
            "license",
            "models"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "beat",
        "energy_and_sections",
        "tags"
      ],
      "additionalProperties": false
    },
    "sections": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "object",
          "properties": {
            "levels": {
              "type": "string",
              "minLength": 1
            },
            "min_bars": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "levels",
            "min_bars"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "kinds",
        "rules"
      ],
      "additionalProperties": false
    },
    "tag_categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "object",
            "minProperties": 1
          },
          "empty_text": {
            "type": "string",
            "minLength": 1
          },
          "uncertain_text": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_label": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "active",
                    "hidden",
                    "deprecated"
                  ]
                }
              },
              "required": [
                "id",
                "source_label",
                "name",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "model",
          "rules",
          "tags"
        ],
        "additionalProperties": false
      }
    },
    "display": {
      "type": "object",
      "properties": {
        "panel_title": {
          "type": "string",
          "minLength": 1
        },
        "panel_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "filter_order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "row": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "category": {
                "type": "string",
                "minLength": 1
              },
              "fallback": {
                "type": "string",
                "minLength": 1
              },
              "skip_uncertain": {
                "type": "boolean"
              }
            },
            "required": [
              "category"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "panel_title",
        "panel_order",
        "filter_order",
        "row"
      ],
      "additionalProperties": false
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "registry_version": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "registry_version",
          "date",
          "request",
          "change"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "registry_version",
    "updated_on",
    "purpose",
    "governance",
    "storage",
    "analyzers",
    "sections",
    "tag_categories",
    "display",
    "changelog"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
