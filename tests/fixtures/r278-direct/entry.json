      "shots": [
        {
          "shotId": "01",
          "dialogue": "清华AI体育博主，断更一年。会写代码，会练体能，就是发不出一条视频。后来我看到一项研究：容易焦虑的人担心的事，百分之九十一没有发生。拦着我的，是脑子里的四句话。今天一句一句，对一对研究。",
          "mainAction": "「91%」大字落地",
          "estimatedSeconds": 18.2,
          "measuredSeconds": null,
          "timingSource": "estimate",
          "status": "rendered",
          "failureCode": null,
